# Paystack Configuration
# Get your secret key from https://dashboard.paystack.co/#/settings/keys
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Server Configuration
PORT=4000

# Firebase Configuration
# For local development: Place your service account key file as serviceAccountKey.json in this directory
# For production (Render): Set FIREBASE_SERVICE_ACCOUNT_KEY environment variable with the entire JSON content
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Traccar Server Configuration (for real GPS trackers)
# Get Traccar server URL and credentials from your Traccar setup
# See TRACKER_SETUP.md for detailed instructions
TRACCAR_URL=https://your-traccar-server.com
TRACCAR_USERNAME=your_traccar_username
TRACCAR_PASSWORD=your_traccar_password
TRACCAR_SYNC_INTERVAL_MS=10000
