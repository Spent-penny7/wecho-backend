# Paystack Configuration
# Get your secret key from https://dashboard.paystack.co/#/settings/keys
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Server Configuration
PORT=4000

# Firebase Configuration
# For local development: Place your service account key file as serviceAccountKey.json in this directory
# For production (Render): Set FIREBASE_SERVICE_ACCOUNT_KEY environment variable with the entire JSON content
# Download from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional Traccar gateway integration
# TRACCAR_URL=https://traccar.example.com
# TRACCAR_USERNAME=wecho-readonly-user
# TRACCAR_PASSWORD=replace-with-a-read-only-account-password
# TRACCAR_SYNC_INTERVAL_MS=10000
